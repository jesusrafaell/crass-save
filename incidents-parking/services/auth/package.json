{
	"name": "webpack-express",
	"version": "1.0.0",
	"main": "./dist/app.js",
	"license": "MIT",
	"scripts": {
		"build": "webpack --mode production",
		"build_old": "npx tsc",
		"start": "cross-env NODE_ENV=production node dist/app.js",
		"grpc:start": "cross-env NODE_ENV=production node dist/grpc.js",
		"start:dev": "cross-env NODE_ENV=development node dist/app.js",
		"dev": "cross-env NODE_ENV=local webpack --mode development && nodemon src/app.ts",
		"migrate:users": "cross-env NODE_ENV=local ts-node src/migration/index.ts",
		"grpc:dev": "cross-env NODE_ENV=local webpack --mode development && nodemon src/grpc.ts",
		"migrate:run": "ts-node src/common/db/migration/index.ts",
		"migrate:preData": "ts-node src/common/db/contents/index.ts",
		"format": "yarn prettier . --write"
	},
	"dependencies": {
		"@babel/core": "^7.22.19",
		"@babel/preset-env": "^7.22.15",
		"@grpc/grpc-js": "^1.10.0",
		"@types/mongodb": "^4.0.7",
		"@types/nodemailer": "^6.4.14",
		"ajv-errors": "^3.0.0",
		"babel-loader": "^9.1.3",
		"bcrypt": "^5.1.1",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express-validator": "^7.0.1",
		"fastify": "^4.25.2",
		"grpc": "^1.24.11",
		"ioredis": "^5.3.2",
		"jsonwebtoken": "^9.0.2",
		"moment": "^2.30.1",
		"mongodb": "^6.3.0",
		"mongoose": "^8.1.1",
		"nodemailer": "^6.9.8",
		"nodemon": "^3.0.1",
		"pg": "^8.11.3",
		"protobufjs": "^7.2.6",
		"redis": "^4.6.13",
		"ts-loader": "^9.4.4",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.14",
		"@types/ioredis": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.3",
		"@types/mongoose": "^5.11.97",
		"@types/node": "^20.11.5",
		"@types/pg": "^8.10.9",
		"@types/redis": "^4.0.11",
		"@types/uuid": "^9.0.7",
		"@types/webpack-node-externals": "^3.0.1",
		"cross-env": "^7.0.3",
		"dotenv-flow": "^4.1.0",
		"prettier": "3.2.4",
		"ts-node-dev": "^2.0.0",
		"ts-proto": "^1.167.3",
		"typescript": "^5.3.3",
		"webpack": "^5.88.2",
		"webpack-cli": "^5.1.4",
		"webpack-node-externals": "^3.0.0"
	}
}
