{
  "name": "crashsaver-diagnose",
  "version": "1.0.0",
  "main": "./dist/app.js",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "lint": "eslint --ext .ts src/**",
    "build": "tsc",
    "build:proto": "make -f Makefile",
    "start": "cross-env NODE_ENV=production tsc-watch --project . --outDir ./dist --onSuccess \"node ./dist/app.js\"",
    "stage": "cross-env NODE_ENV=development tsc-watch --project . --outDir ./dist --onSuccess \"node ./dist/app.js\"",
    "prod": "cross-env NODE_ENV=production tsc-watch --project . --outDir ./dist --onSuccess \"nodemon ./dist/app.js\"",
    "dev": "cross-env NODE_ENV=development tsc-watch --project . --outDir ./dist --onSuccess \"nodemon ./dist/app.js\"",
    "local": "cross-env NODE_ENV=local tsc-watch --project . --outDir ./dist --onSuccess \"nodemon ./dist/app.js\"",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=9.5.1"
  },
  "packageManager": "yarn@4.0.2",
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@types/apicache": "^1.6.6",
    "@types/aws-sdk": "^2.7.0",
    "@types/better-queue": "^3.8.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/dotenv-flow": "^3.3.3",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.10",
    "nodemon": "^3.0.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.509.0",
    "@aws-sdk/lib-storage": "^3.509.0",
    "ajv": "^8.12.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^2.1.1",
    "apicache": "^1.6.3",
    "bcrypt": "^5.1.1",
    "better-queue": "^3.8.12",
    "bson": "^6.3.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv-flow": "^4.1.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.12.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "morgan": "^1.10.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.2",
    "tsc-watch": "^6.0.4",
    "uuid": "^9.0.1",
    "uuid-mongodb": "^2.5.5"
  }
}
