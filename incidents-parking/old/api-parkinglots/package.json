{
	"name": "webpack-express",
	"version": "1.0.0",
	"main": "./dist/app.js",
	"license": "MIT",
	"scripts": {
		"build": "webpack --mode production",
		"build_old": "npx tsc",
		"start": "cross-env NODE_ENV=production node dist/app.js",
		"start:dev": "cross-env NODE_ENV=development node dist/app.js",
		"dev": "cross-env NODE_ENV=local webpack --mode development && nodemon src/app.ts",
		"migrate:run": "ts-node src/common/db/migration/index.ts",
		"migrate:preData": "ts-node src/common/db/contents/index.ts"
	},
	"dependencies": {
		"@babel/core": "^7.22.19",
		"@babel/preset-env": "^7.22.15",
		"ajv-errors": "^3.0.0",
		"babel-loader": "^9.1.3",
		"bcrypt": "^5.1.1",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express-validator": "^7.0.1",
		"fastify": "^4.25.2",
		"jsonwebtoken": "^9.0.2",
		"moment": "^2.30.1",
		"nodemon": "^3.0.1",
		"pg": "^8.11.3",
		"ts-loader": "^9.4.4",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.14",
		"@types/jsonwebtoken": "^9.0.3",
		"@types/node": "^20.11.5",
		"@types/pg": "^8.10.9",
		"@types/uuid": "^9.0.7",
		"@types/webpack-node-externals": "^3.0.1",
		"cross-env": "^7.0.3",
		"dotenv-flow": "^4.1.0",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.3.3",
		"webpack": "^5.88.2",
		"webpack-cli": "^5.1.4",
		"webpack-node-externals": "^3.0.0"
	}
}
